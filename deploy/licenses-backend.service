# deploy/licenses-backend.service  →  /etc/systemd/system/
[Unit]
Description=Waters license PDF -> Excel cleaner (Flask/gunicorn)
After=network.target

[Service]
Type=simple
User=matt
Group=matt
WorkingDirectory=/home/matt/licenses-site
Environment=TMPDIR=/home/matt/licenses-site/gunicorn-tmp
ExecStart=/home/matt/licenses-site/venv/bin/gunicorn -w 2 --threads 4 \
    -b 127.0.0.1:8797 --access-logfile - --error-logfile - --timeout 60 app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/matt/licenses-site/gunicorn-tmp

[Install]
WantedBy=multi-user.target
